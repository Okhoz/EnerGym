# Desarrollo local; este archivo es plantilla y el servidor no lo carga automáticamente.
ENERGYM_HOST=127.0.0.1
ENERGYM_PORT=8080
ENERGYM_DEV_MODE=true
# Vacío deshabilita emparejamiento. Sustituir por código aleatorio privado de 24–128 caracteres.
ENERGYM_PAIRING_CODE=
# Selección explícita: none (predeterminado), gemini u openai. Una clave nunca activa llamadas.
ENERGYM_AI_PROVIDER=none
# Gemini solo para pruebas de desarrollo con cuota gratuita del proyecto; no habilitar billing.
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# OpenAI requiere selección explícita y opt-in independiente; puede facturar.
OPENAI_ENABLED=false
OPENAI_MODEL=
OPENAI_API_KEY=
# Fuera de loopback/desarrollo, TLS directo obligatorio. Rutas/contraseñas privadas, nunca al repositorio.
ENERGYM_TLS_KEYSTORE=
ENERGYM_TLS_PASSWORD=
