# Non-secret configuration for Render Dashboard (not automatically read by Java).
ENERGYM_TRANSPORT=render
ENERGYM_AUTH_MODE=firebase
ENERGYM_DEV_MODE=false
ENERGYM_AI_PROVIDER=groq
GROQ_ENABLED=true
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_ENABLED=false
OPENAI_ENABLED=false
FIREBASE_PROJECT_ID=energym-e4699
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
QUOTA_SCOPE=energym
QUOTA_UID_PER_DAY=20
QUOTA_GLOBAL_PER_DAY=200
QUOTA_UID_PER_MINUTE=3
QUOTA_GLOBAL_PER_MINUTE=20
# Enter GROQ_API_KEY and QUOTA_UID_SALT in secret fields; no values belong here.
# RENDER, PORT and RENDER_EXTERNAL_HOSTNAME are injected by Render; do not invent them.
