# HTTPS en ambos saltos. No access log de URL, perfiles, tokens ni mensajes.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 128; }
http {
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    limit_req_zone $binary_remote_addr zone=api:1m rate=2r/s;
    server {
        listen 8443 ssl;
        server_name _;
        ssl_certificate /run/secrets/frontend_cert;
        ssl_certificate_key /run/secrets/frontend_key;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 32k;
        client_body_timeout 10s;
        client_header_timeout 10s;
        keepalive_timeout 15s;
        add_header X-Content-Type-Options nosniff always;
        location = /health {
            proxy_pass https://backend:8080;
            proxy_ssl_verify on;
            proxy_ssl_server_name on;
            proxy_ssl_name backend;
            proxy_ssl_trusted_certificate /run/secrets/backend_ca;
            proxy_set_header Authorization "";
            proxy_set_header X-EnerGym-Proxy-Token "";
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Real-IP "";
        }
        location /api/ {
            limit_req zone=api burst=4 nodelay;
            limit_req_status 429;
            proxy_pass https://backend:8080;
            proxy_http_version 1.1;
            proxy_ssl_verify on;
            proxy_ssl_server_name on;
            proxy_ssl_name backend;
            proxy_ssl_trusted_certificate /run/secrets/backend_ca;
            proxy_connect_timeout 3s;
            proxy_read_timeout 30s;
            proxy_send_timeout 10s;
            proxy_next_upstream off;
            proxy_set_header Host backend;
            proxy_set_header X-EnerGym-Proxy-Token "${ENERGYM_PROXY_TOKEN}";
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Real-IP "";
        }
        location / { return 404; }
    }
}
