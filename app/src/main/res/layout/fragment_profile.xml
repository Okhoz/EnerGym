						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/space_inline"
							style="@style/EnerGym.Body"
							tools:text="Indica tu nivel. Los demás datos de este bloque son opcionales." />

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_marginTop="@dimen/space_inline">

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									style="@style/EnerGym.FieldCaption"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									tools:text="Nivel" />

								<com.google.android.material.textfield.TextInputLayout
									style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									app:hintEnabled="false"
									tools:helperTextEnabled="true"
									tools:helperTextTextAppearance="@style/EnerGym.FieldCaption"
									tools:helperText="Describe tu nivel actual para orientar la dificultad."
									app:boxBackgroundColor="@color/glass_field"
									app:boxStrokeColor="@color/field_outline"
									app:boxStrokeWidth="1dp"
									app:boxStrokeWidthFocused="2dp"
									app:boxCornerRadiusTopStart="12dp"
