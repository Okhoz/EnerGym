										tools:hint="Ej.: 6 meses de entrenamiento de fuerza" />
								</com.google.android.material.textfield.TextInputLayout>
							</LinearLayout>

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									style="@style/EnerGym.FieldCaption"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									tools:text="Espacio disponible (opcional)" />

								<com.google.android.material.textfield.TextInputLayout
									style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									app:hintEnabled="false"
									tools:helperTextEnabled="true"
									tools:helperTextTextAppearance="@style/EnerGym.FieldCaption"
									tools:helperText="Describe el espacio libre en el que podrás moverte."
									app:boxBackgroundColor="@color/glass_field"
									app:boxStrokeColor="@color/field_outline"
									app:boxStrokeWidth="1dp"
									app:boxStrokeWidthFocused="2dp"
									app:boxCornerRadiusTopStart="12dp"
									app:boxCornerRadiusTopEnd="12dp"
									app:boxCornerRadiusBottomStart="12dp"
