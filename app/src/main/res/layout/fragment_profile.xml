<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true"
	android:saveEnabled="false"
	android:background="@android:color/transparent"
	android:clipToPadding="false"
	tools:context=".MainActivity">

	<LinearLayout
		android:id="@+id/screen_body"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="@dimen/screen_gutter"
		android:paddingTop="@dimen/section_gap"
		android:paddingBottom="@dimen/content_bottom">

		<TextView
			android:id="@+id/eyebrow"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/EnerGym.Eyebrow"
			tools:text="PERSONALIZA" />

		<TextView
			android:id="@+id/screen_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/space_inline"
			style="@style/EnerGym.ScreenTitle"
			tools:text="Tu perfil" />

		<TextView
			android:id="@+id/screen_subtitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/space_inline"
			android:layout_marginBottom="@dimen/section_gap"
			style="@style/EnerGym.Body"
			tools:text="Define cómo quieres entrenar. Guardar conserva tu perfil; después podrás crear una rutina desde Entrenamiento." />

		<LinearLayout
			android:id="@+id/rows"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="gone"
				tools:visibility="visible"
				android:importantForAccessibility="noHideDescendants">
				<!-- Solo editor: GONE en ejecución; ScreenFragment.render elimina estas filas. -->
				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="@dimen/section_gap"
					style="@style/EnerGym.GlassCard">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="@dimen/card_padding"
						android:background="@drawable/glass_panel">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							style="@style/EnerGym.CardTitle"
							tools:text="Tu entrenamiento" />

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/space_inline"
							style="@style/EnerGym.Body"
							tools:text="Elige la actividad, el objetivo y el entorno." />

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_marginTop="@dimen/space_inline">

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									style="@style/EnerGym.FieldCaption"
									tools:text="Tipo de entrenamiento" />

								<FrameLayout
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:background="@drawable/choice_outline">

									<Spinner
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingEnd="40dp"
										android:spinnerMode="dropdown"
										android:background="@null"
										android:popupBackground="@drawable/choice_outline"
										android:saveEnabled="false"
										tools:visibility="gone" />

									<ImageView
										android:layout_width="24dp"
										android:layout_height="24dp"
										android:layout_gravity="end|center_vertical"
										android:layout_marginEnd="12dp"
										android:src="@drawable/ic_expand"
										android:importantForAccessibility="no" />

									<TextView
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:gravity="center_vertical"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:textColor="@color/white"
										android:textSize="16sp"
										tools:text="Sin equipamiento"
										android:layout_marginEnd="40dp"
										android:visibility="gone"
										tools:visibility="visible"
										android:importantForAccessibility="noHideDescendants" />
								</FrameLayout>
							</LinearLayout>

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									style="@style/EnerGym.FieldCaption"
									tools:text="Disciplina" />

								<FrameLayout
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:background="@drawable/choice_outline">

									<Spinner
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingEnd="40dp"
										android:spinnerMode="dropdown"
										android:background="@null"
										android:popupBackground="@drawable/choice_outline"
										android:saveEnabled="false"
										tools:visibility="gone" />

									<ImageView
										android:layout_width="24dp"
										android:layout_height="24dp"
										android:layout_gravity="end|center_vertical"
										android:layout_marginEnd="12dp"
										android:src="@drawable/ic_expand"
										android:importantForAccessibility="no" />

									<TextView
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:gravity="center_vertical"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:textColor="@color/white"
										android:textSize="16sp"
										tools:text="Fuerza"
										android:layout_marginEnd="40dp"
										android:visibility="gone"
										tools:visibility="visible"
										android:importantForAccessibility="noHideDescendants" />
								</FrameLayout>
							</LinearLayout>

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									style="@style/EnerGym.FieldCaption"
									tools:text="Objetivo" />

								<FrameLayout
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:background="@drawable/choice_outline">

									<Spinner
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingEnd="40dp"
										android:spinnerMode="dropdown"
										android:background="@null"
										android:popupBackground="@drawable/choice_outline"
										android:saveEnabled="false"
										tools:visibility="gone" />

									<ImageView
										android:layout_width="24dp"
										android:layout_height="24dp"
										android:layout_gravity="end|center_vertical"
										android:layout_marginEnd="12dp"
										android:src="@drawable/ic_expand"
										android:importantForAccessibility="no" />

									<TextView
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:gravity="center_vertical"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:textColor="@color/white"
										android:textSize="16sp"
										tools:text="Condición general"
										android:layout_marginEnd="40dp"
										android:visibility="gone"
										tools:visibility="visible"
										android:importantForAccessibility="noHideDescendants" />
								</FrameLayout>
							</LinearLayout>

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									style="@style/EnerGym.FieldCaption"
									tools:text="Dónde entrenas" />

								<FrameLayout
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:background="@drawable/choice_outline">

									<Spinner
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingEnd="40dp"
										android:spinnerMode="dropdown"
										android:background="@null"
										android:popupBackground="@drawable/choice_outline"
										android:saveEnabled="false"
										tools:visibility="gone" />

									<ImageView
										android:layout_width="24dp"
										android:layout_height="24dp"
										android:layout_gravity="end|center_vertical"
										android:layout_marginEnd="12dp"
										android:src="@drawable/ic_expand"
										android:importantForAccessibility="no" />

									<TextView
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:gravity="center_vertical"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:textColor="@color/white"
										android:textSize="16sp"
										tools:text="Casa"
										android:layout_marginEnd="40dp"
										android:visibility="gone"
										tools:visibility="visible"
										android:importantForAccessibility="noHideDescendants" />
								</FrameLayout>
							</LinearLayout>

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									style="@style/EnerGym.FieldCaption"
									tools:text="Qué quieres trabajar" />

								<FrameLayout
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:background="@drawable/choice_outline">

									<Spinner
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingEnd="40dp"
										android:spinnerMode="dropdown"
										android:background="@null"
										android:popupBackground="@drawable/choice_outline"
										android:saveEnabled="false"
										tools:visibility="gone" />

									<ImageView
										android:layout_width="24dp"
										android:layout_height="24dp"
										android:layout_gravity="end|center_vertical"
										android:layout_marginEnd="12dp"
										android:src="@drawable/ic_expand"
										android:importantForAccessibility="no" />

									<TextView
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:gravity="center_vertical"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:textColor="@color/white"
										android:textSize="16sp"
										tools:text="Específica"
										android:layout_marginEnd="40dp"
										android:visibility="gone"
										tools:visibility="visible"
										android:importantForAccessibility="noHideDescendants" />
								</FrameLayout>
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="@dimen/section_gap"
					style="@style/EnerGym.GlassCard">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="@dimen/card_padding"
						android:background="@drawable/glass_panel">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							style="@style/EnerGym.CardTitle"
							tools:text="Tu disponibilidad" />

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/space_inline"
							style="@style/EnerGym.Body"
							tools:text="Usa una disponibilidad que puedas mantener." />

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_marginTop="@dimen/space_inline">

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									style="@style/EnerGym.FieldCaption"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									tools:text="Días por semana (1–7)" />

								<com.google.android.material.textfield.TextInputLayout
									style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									app:hintEnabled="false"
									tools:helperTextEnabled="true"
									tools:helperTextTextAppearance="@style/EnerGym.FieldCaption"
									tools:helperText="Indica cuántos días podrás entrenar cada semana."
									app:boxBackgroundColor="@color/glass_field"
									app:boxStrokeColor="@color/field_outline"
									app:boxStrokeWidth="1dp"
									app:boxStrokeWidthFocused="2dp"
									app:boxCornerRadiusTopStart="12dp"
									app:boxCornerRadiusTopEnd="12dp"
									app:boxCornerRadiusBottomStart="12dp"
									app:boxCornerRadiusBottomEnd="12dp">

									<com.google.android.material.textfield.TextInputEditText
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:inputType="textCapSentences"
										android:textColor="@color/white"
										android:textSize="16sp"
										android:saveEnabled="false"
										tools:text=""
										tools:textColorHint="@color/text_secondary"
										tools:hint="Ej.: 3" />
								</com.google.android.material.textfield.TextInputLayout>
							</LinearLayout>

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									style="@style/EnerGym.FieldCaption"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									tools:text="Tiempo por sesión (5–240 min)" />

								<com.google.android.material.textfield.TextInputLayout
									style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									app:hintEnabled="false"
									tools:helperTextEnabled="true"
									tools:helperTextTextAppearance="@style/EnerGym.FieldCaption"
									tools:helperText="Es el tiempo disponible para cada sesión, en minutos."
									app:boxBackgroundColor="@color/glass_field"
									app:boxStrokeColor="@color/field_outline"
									app:boxStrokeWidth="1dp"
									app:boxStrokeWidthFocused="2dp"
									app:boxCornerRadiusTopStart="12dp"
									app:boxCornerRadiusTopEnd="12dp"
									app:boxCornerRadiusBottomStart="12dp"
									app:boxCornerRadiusBottomEnd="12dp">

									<com.google.android.material.textfield.TextInputEditText
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:inputType="textCapSentences"
										android:textColor="@color/white"
										android:textSize="16sp"
										android:saveEnabled="false"
										tools:text=""
										tools:textColorHint="@color/text_secondary"
										tools:hint="Ej.: 45" />
								</com.google.android.material.textfield.TextInputLayout>
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="@dimen/section_gap"
					style="@style/EnerGym.GlassCard">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="@dimen/card_padding"
						android:background="@drawable/glass_panel">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							style="@style/EnerGym.CardTitle"
