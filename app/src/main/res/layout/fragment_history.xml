<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true"
	android:saveEnabled="false"
	android:background="@android:color/transparent"
	android:clipToPadding="false"
	tools:context=".MainActivity">

	<LinearLayout
		android:id="@+id/screen_body"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="@dimen/screen_gutter"
		android:paddingTop="@dimen/section_gap"
		android:paddingBottom="@dimen/content_bottom">

		<TextView
			android:id="@+id/eyebrow"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/EnerGym.Eyebrow"
			tools:text="LO QUE HAS HECHO" />

		<TextView
			android:id="@+id/screen_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/space_inline"
			style="@style/EnerGym.ScreenTitle"
			tools:text="Tu historial" />

		<TextView
			android:id="@+id/screen_subtitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/space_inline"
			android:layout_marginBottom="@dimen/section_gap"
			style="@style/EnerGym.Body"
			tools:text="Resultados realizados, con el perfil y los ejercicios de aquel entrenamiento." />

		<LinearLayout
			android:id="@+id/rows"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="gone"
				tools:visibility="visible"
				android:importantForAccessibility="noHideDescendants">
				<!-- Solo editor: GONE en ejecución; ScreenFragment.render elimina estas filas. -->
				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="@dimen/section_gap"
					style="@style/EnerGym.GlassCard">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="@dimen/card_padding"
						android:background="@drawable/glass_panel">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							style="@style/EnerGym.CardTitle"
							tools:text="Sesión finalizada" />

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/space_inline"
							style="@style/EnerGym.Body"
							tools:text="Ejemplo de diseño · fecha del entrenamiento&#xA;Perfil conservado de aquella sesión&#xA;&#xA;Ejercicio de ejemplo&#xA;Aquí se muestran los valores realizados, no la prescripción." />

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_marginTop="@dimen/space_inline" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="@dimen/section_gap"
					style="@style/EnerGym.GlassCard">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="@dimen/card_padding"
						android:background="@drawable/glass_panel">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							style="@style/EnerGym.CardTitle"
							tools:text="Borrador pendiente" />

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/space_inline"
							style="@style/EnerGym.Body"
							tools:text="Ejemplo de diseño · rutina con ejercicios pendientes" />

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_marginTop="@dimen/space_inline">

							<com.energym.app.ui.effects.GlassButton
								style="@style/EnerGym.Button"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:minHeight="@dimen/primary_touch_target"
								android:layout_marginTop="@dimen/action_gap"
								android:layout_marginBottom="0dp"
								android:textSize="16sp"
								tools:text="Continuar borrador" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</ScrollView>
