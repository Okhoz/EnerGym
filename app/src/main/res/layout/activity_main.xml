<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@color/surface"
	tools:context=".MainActivity">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="56dp"
		android:background="@drawable/glass_chrome"
		android:layout_marginHorizontal="0dp"
		android:layout_marginTop="0dp"
		android:gravity="center_vertical"
		android:paddingHorizontal="@dimen/chrome_padding"
		android:paddingVertical="4dp">

		<com.energym.app.ui.effects.GlassButton
			android:id="@+id/back"
			style="@style/EnerGym.Button"
			android:layout_width="48dp"
			android:layout_height="wrap_content"
			android:layout_marginEnd="@dimen/space_inline"
			android:padding="0dp"
			android:text="‹"
			android:textSize="28sp"
			android:contentDescription="@string/back"
			android:visibility="gone"
			android:minHeight="@dimen/touch_target" />

		<ImageView
			android:layout_width="32dp"
			android:layout_height="32dp"
			android:layout_marginEnd="@dimen/space_inline"
			android:src="@drawable/ic_brand"
			android:scaleType="fitCenter"
			android:contentDescription="@string/logo_description" />

		<TextView
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:text="@string/app_name"
			android:textSize="22sp"
			android:textStyle="bold"
			android:letterSpacing="-0.02"
			android:fontFamily="sans-serif"
			android:textColor="@color/white"
			android:layout_marginEnd="@dimen/space_inline" />

		<!-- Foto de perfil (o icono de persona): al tocarla se elige, cambia o quita la foto. -->
		<com.google.android.material.imageview.ShapeableImageView
			android:id="@+id/avatar"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:layout_marginEnd="8dp"
			android:padding="10dp"
			android:background="@color/glass_button"
			android:scaleType="centerCrop"
			android:src="@drawable/ic_account"
			android:clickable="true"
			android:focusable="true"
			android:contentDescription="@string/avatar_description"
			android:tooltipText="@string/avatar_description"
			app:shapeAppearanceOverlay="@style/EnerGym.Circle" />

		<com.energym.app.ui.effects.GlassButton
			android:id="@+id/account"
			style="@style/EnerGym.IconButton"
			android:layout_width="@dimen/touch_target"
			android:layout_height="wrap_content"
			android:minHeight="@dimen/touch_target"
			android:minWidth="@dimen/touch_target"
			android:paddingHorizontal="12dp"
			android:paddingVertical="12dp"
			android:textSize="14sp"
			android:contentDescription="@string/menu"
			android:tooltipText="@string/menu"
			app:icon="@drawable/ic_menu"
			app:iconSize="24dp"
			app:iconPadding="0dp"
			app:iconGravity="textStart" />
	</LinearLayout>

	<TextView
		android:id="@+id/status"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingHorizontal="@dimen/screen_gutter"
		android:paddingBottom="8dp"
		android:textSize="12sp"
		android:lineSpacingExtra="3dp"
		android:textColor="@color/text_secondary"
		android:accessibilityLiveRegion="polite"
		tools:text="Sin cuenta · almacenamiento local"
		android:visibility="gone"
		android:paddingTop="@dimen/label_gap" />

	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@color/glass_highlight" />

	<androidx.constraintlayout.motion.widget.MotionLayout
		android:id="@+id/screen_motion"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		app:layoutDescription="@xml/screen_motion"
		app:currentState="@id/screen_rest">

		<View
			android:id="@+id/glass_decoration"
			android:layout_width="256px"
			android:layout_height="192px"
			android:background="@drawable/glass_decoration"
			android:importantForAccessibility="no"
			android:clickable="false"
			android:focusable="false"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintEnd_toEndOf="parent" />

		<androidx.fragment.app.FragmentContainerView
			android:id="@+id/content"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			tools:visibility="gone" />

		<include
			android:id="@+id/home_preview"
			layout="@layout/fragment_home"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			android:visibility="gone"
			tools:visibility="visible"
			android:importantForAccessibility="noHideDescendants" />
	</androidx.constraintlayout.motion.widget.MotionLayout>

	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@color/glass_highlight" />

	<com.google.android.material.bottomnavigation.BottomNavigationView
		android:id="@+id/navigation"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="0dp"
		android:layout_marginBottom="0dp"
		android:background="@drawable/glass_chrome"
		app:menu="@menu/main_navigation"
		app:labelVisibilityMode="labeled"
		app:itemIconTint="@color/nav_colors"
		app:itemTextColor="@color/nav_colors"
		app:itemActiveIndicatorStyle="@style/EnerGym.NavigationIndicator"
		app:itemHorizontalTranslationEnabled="false"
		app:itemTextAppearanceActive="@style/EnerGym.NavigationLabel"
		app:itemTextAppearanceInactive="@style/EnerGym.NavigationLabel"
		app:itemTextAppearanceActiveBoldEnabled="false" />
</LinearLayout>
