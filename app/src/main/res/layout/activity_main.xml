		<androidx.fragment.app.FragmentContainerView android:id="@+id/content" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" tools:visibility="gone" />
		<include android:id="@+id/home_preview" layout="@layout/fragment_home" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:visibility="gone" tools:visibility="visible" android:importantForAccessibility="noHideDescendants" />
	</androidx.constraintlayout.motion.widget.MotionLayout>
	<View android:layout_width="match_parent" android:layout_height="1dp" android:background="@android:color/transparent" />
	<com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginBottom="8dp" android:background="@drawable/glass_chrome" app:menu="@menu/main_navigation" app:labelVisibilityMode="labeled" app:itemIconTint="@color/nav_colors" app:itemTextColor="@color/button_text" app:itemActiveIndicatorStyle="@style/EnerGym.NavigationIndicator" />
</LinearLayout>
