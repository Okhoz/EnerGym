<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface" tools:context=".MainActivity">
	<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:background="@drawable/glass_chrome" android:layout_marginHorizontal="12dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingVertical="12dp">
		<com.energym.app.ui.effects.GlassButton android:id="@+id/back" style="@style/EnerGym.Button" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="8dp" android:padding="0dp" android:text="‹" android:textSize="28sp" android:contentDescription="@string/back" android:visibility="gone" />
		<ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="10dp" android:src="@drawable/energym_logo" android:scaleType="fitCenter" android:contentDescription="@string/logo_description" />
		<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="22sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="@color/white" />
		<com.energym.app.ui.effects.GlassButton android:id="@+id/account" style="@style/EnerGym.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="72dp" android:paddingHorizontal="12dp" android:paddingVertical="10dp" android:textSize="14sp" android:text="@string/account" />
	</LinearLayout>
	<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingBottom="16dp" android:textSize="12sp" android:lineSpacingExtra="3dp" android:textColor="@color/text_secondary" android:accessibilityLiveRegion="polite" tools:text="Sin cuenta · almacenamiento local" />
	<View android:layout_width="match_parent" android:layout_height="1dp" android:background="@android:color/transparent" />
	<androidx.constraintlayout.motion.widget.MotionLayout android:id="@+id/screen_motion" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" app:layoutDescription="@xml/screen_motion" app:currentState="@id/screen_rest">
