<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/anatomy_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@color/surface"
	tools:context=".ui.AnatomyActivity">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="56dp"
		android:background="@drawable/glass_chrome"
		android:layout_marginHorizontal="0dp"
		android:layout_marginTop="0dp"
		android:gravity="center_vertical"
		android:paddingHorizontal="@dimen/chrome_padding"
		android:paddingVertical="4dp">

		<com.energym.app.ui.effects.GlassButton
			android:id="@+id/viewer_back"
			style="@style/EnerGym.Button"
			android:layout_width="48dp"
			android:layout_height="wrap_content"
			android:layout_marginEnd="@dimen/space_inline"
			android:padding="0dp"
			android:text="‹"
			android:textSize="28sp"
			android:contentDescription="@string/back"
			android:minHeight="@dimen/touch_target" />

		<ImageView
			android:layout_width="32dp"
			android:layout_height="32dp"
			android:layout_marginEnd="@dimen/space_inline"
			android:src="@drawable/ic_brand"
			android:scaleType="fitCenter"
			android:contentDescription="@string/logo_description" />

		<TextView
			android:layout_width="0dp"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			android:text="@string/app_name"
			android:textSize="20sp"
			android:textStyle="bold"
			android:textColor="@color/white"
			android:layout_marginEnd="@dimen/space_inline" />
	</LinearLayout>

	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@color/disabled_outline" />

	<ScrollView
		android:id="@+id/viewer_scroll"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true"
		android:clipToPadding="false">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingHorizontal="@dimen/screen_gutter"
			android:paddingTop="@dimen/section_gap"
			android:paddingBottom="@dimen/content_bottom">

			<TextView
				style="@style/EnerGym.Eyebrow"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/anatomy_eyebrow" />

			<TextView
				android:id="@+id/viewer_title"
				style="@style/EnerGym.ScreenTitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/space_inline"
				android:text="@string/anatomy_title" />

			<TextView
				style="@style/EnerGym.Body"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/space_inline"
				android:text="@string/anatomy_preview" />

			<TextView
				style="@style/EnerGym.FieldCaption"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="0dp"
				android:text="@string/anatomy_disclaimer" />

			<FrameLayout
				android:layout_width="match_parent"
				android:layout_height="300dp"
				android:layout_marginTop="@dimen/group_gap"
				android:background="#000000">
				<!-- Visor nativo: sin RenderEffect, captura ni desenfoque para priorizar el renderizador. -->
				<SurfaceView
					android:id="@+id/viewer_surface"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					tools:visibility="gone"
					android:contentDescription="@string/anatomy_viewer_description" />

				<LinearLayout
					android:id="@+id/viewer_loading"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical"
					android:gravity="center"
					android:padding="@dimen/card_padding"
					android:background="#000000"
					tools:visibility="gone">

					<ProgressBar
						android:id="@+id/viewer_progress"
						style="?android:attr/progressBarStyleHorizontal"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:indeterminate="true"
						android:progressTint="@color/gold"
						android:indeterminateTint="@color/gold" />

					<TextView
						android:id="@+id/viewer_load_message"
						style="@style/EnerGym.Body"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/control_gap_vertical"
						android:gravity="center"
						android:accessibilityLiveRegion="polite"
						android:text="@string/anatomy_checking" />
				</LinearLayout>

				<!-- Marcador exclusivo del editor: el visor real conserva su fondo negro. -->
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical"
					android:gravity="center"
					android:padding="@dimen/card_padding"
					android:visibility="gone"
					tools:visibility="visible"
					tools:background="@drawable/viewer_editor_preview"
					android:importantForAccessibility="noHideDescendants">

					<ImageView
						android:layout_width="80dp"
						android:layout_height="80dp"
						android:src="@drawable/ic_brand"
						android:scaleType="fitCenter"
						android:contentDescription="@string/logo_description" />

					<TextView
						style="@style/EnerGym.CardTitle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/control_gap_vertical"
						android:gravity="center"
						tools:textColor="@color/white"
						tools:text="Recurso 3D local" />

					<TextView
						style="@style/EnerGym.Body"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/control_gap_vertical"
						android:gravity="center"
						tools:textColor="@color/text_secondary"
						tools:text="La animación se muestra al ejecutar la app." />
				</LinearLayout>
			</FrameLayout>

			<TextView
				android:id="@+id/viewer_status"
				style="@style/EnerGym.FieldCaption"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/space_inline"
				android:accessibilityLiveRegion="polite"
				android:text="@string/anatomy_offline" />

			<LinearLayout
				android:id="@+id/viewer_controls"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="gone"
				tools:visibility="visible">

				<com.energym.app.ui.effects.GlassButton
					android:id="@+id/viewer_play"
					style="@style/EnerGym.Button"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="@dimen/touch_target"
					android:layout_marginTop="@dimen/control_gap_vertical"
					android:text="@string/anatomy_pause" />

				<TextView
					style="@style/EnerGym.FieldCaption"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/group_gap"
					android:text="@string/anatomy_speed" />

				<androidx.constraintlayout.widget.ConstraintLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/control_gap_vertical">

					<com.energym.app.ui.effects.GlassButton
						android:backgroundTint="@color/viewer_control_surface"
						android:id="@+id/viewer_speed_quarter"
						style="@style/EnerGym.ViewerButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/an_speed_quarter" />

					<com.energym.app.ui.effects.GlassButton
						android:backgroundTint="@color/viewer_control_surface"
						android:id="@+id/viewer_speed_half"
						style="@style/EnerGym.ViewerButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/an_speed_half" />

					<com.energym.app.ui.effects.GlassButton
						android:backgroundTint="@color/viewer_control_surface"
						android:id="@+id/viewer_speed_normal"
						style="@style/EnerGym.ViewerButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/an_speed_normal" />

					<androidx.constraintlayout.helper.widget.Flow
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintEnd_toEndOf="parent"
						app:constraint_referenced_ids="viewer_speed_quarter,viewer_speed_half,viewer_speed_normal"
						app:flow_wrapMode="chain"
						app:flow_horizontalStyle="packed"
						app:flow_horizontalBias="0"
						app:flow_horizontalGap="@dimen/control_gap_horizontal"
						app:flow_verticalGap="@dimen/control_gap_vertical" />
				</androidx.constraintlayout.widget.ConstraintLayout>

				<TextView
					style="@style/EnerGym.FieldCaption"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/group_gap"
					android:text="@string/anatomy_frames" />

				<androidx.constraintlayout.widget.ConstraintLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/control_gap_vertical">

					<com.energym.app.ui.effects.GlassButton
						android:id="@+id/viewer_initial"
						style="@style/EnerGym.ViewerButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/anatomy_frame_start" />

					<com.energym.app.ui.effects.GlassButton
						android:id="@+id/viewer_middle"
						style="@style/EnerGym.ViewerButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/anatomy_frame_middle" />

					<com.energym.app.ui.effects.GlassButton
						android:id="@+id/viewer_final"
						style="@style/EnerGym.ViewerButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/anatomy_frame_end" />

					<androidx.constraintlayout.helper.widget.Flow
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintEnd_toEndOf="parent"
						app:constraint_referenced_ids="viewer_initial,viewer_middle,viewer_final"
						app:flow_wrapMode="chain"
						app:flow_horizontalStyle="packed"
						app:flow_horizontalBias="0"
						app:flow_horizontalGap="@dimen/control_gap_horizontal"
						app:flow_verticalGap="@dimen/control_gap_vertical" />
				</androidx.constraintlayout.widget.ConstraintLayout>

				<TextView
					style="@style/EnerGym.FieldCaption"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/group_gap"
					android:text="@string/anatomy_camera" />

				<androidx.constraintlayout.widget.ConstraintLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/control_gap_vertical">

					<com.energym.app.ui.effects.GlassButton
						android:id="@+id/viewer_rotate_left"
						style="@style/EnerGym.ViewerCameraButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/anatomy_rotate_left" />

					<com.energym.app.ui.effects.GlassButton
						android:id="@+id/viewer_rotate_right"
						style="@style/EnerGym.ViewerCameraButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/anatomy_rotate_right" />

					<androidx.constraintlayout.helper.widget.Flow
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintEnd_toEndOf="parent"
						app:constraint_referenced_ids="viewer_rotate_left,viewer_rotate_right"
						app:flow_wrapMode="chain"
						app:flow_horizontalStyle="packed"
						app:flow_horizontalBias="0"
						app:flow_horizontalGap="@dimen/control_gap_horizontal"
						app:flow_verticalGap="@dimen/control_gap_vertical" />
				</androidx.constraintlayout.widget.ConstraintLayout>

				<androidx.constraintlayout.widget.ConstraintLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/control_gap_vertical">

					<com.energym.app.ui.effects.GlassButton
						android:id="@+id/viewer_zoom_in"
						style="@style/EnerGym.ViewerCameraButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/anatomy_zoom_in" />

					<com.energym.app.ui.effects.GlassButton
						android:id="@+id/viewer_zoom_out"
						style="@style/EnerGym.ViewerCameraButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/anatomy_zoom_out" />

					<androidx.constraintlayout.helper.widget.Flow
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintEnd_toEndOf="parent"
						app:constraint_referenced_ids="viewer_zoom_in,viewer_zoom_out"
						app:flow_wrapMode="chain"
						app:flow_horizontalStyle="packed"
						app:flow_horizontalBias="0"
						app:flow_horizontalGap="@dimen/control_gap_horizontal"
						app:flow_verticalGap="@dimen/control_gap_vertical" />
				</androidx.constraintlayout.widget.ConstraintLayout>

				<androidx.constraintlayout.widget.ConstraintLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/control_gap_vertical">

					<com.energym.app.ui.effects.GlassButton
						android:id="@+id/viewer_front"
						style="@style/EnerGym.ViewerCameraButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/anatomy_front" />

					<com.energym.app.ui.effects.GlassButton
						android:id="@+id/viewer_side"
						style="@style/EnerGym.ViewerCameraButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:minHeight="@dimen/touch_target"
						android:text="@string/anatomy_side" />

					<androidx.constraintlayout.helper.widget.Flow
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintEnd_toEndOf="parent"
						app:constraint_referenced_ids="viewer_front,viewer_side"
						app:flow_wrapMode="chain"
						app:flow_horizontalStyle="packed"
						app:flow_horizontalBias="0"
						app:flow_horizontalGap="@dimen/control_gap_horizontal"
						app:flow_verticalGap="@dimen/control_gap_vertical" />
				</androidx.constraintlayout.widget.ConstraintLayout>

				<com.energym.app.ui.effects.GlassButton
					android:id="@+id/viewer_reset"
					style="@style/EnerGym.Button"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/control_gap_vertical"
					android:minHeight="@dimen/touch_target"
					android:text="@string/anatomy_reset_camera" />
			</LinearLayout>

			<TextView
				android:id="@+id/viewer_availability_title"
				style="@style/EnerGym.CardTitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/section_gap"
				android:text="@string/anatomy_availability" />

			<com.energym.app.ui.effects.GlassButton
				style="@style/EnerGym.Button"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/space_inline"
				android:enabled="false"
				android:text="@string/anatomy_layers" />

			<TextView
				style="@style/EnerGym.Body"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/space_inline"
				android:text="@string/anatomy_layers_body" />

			<TextView
				android:id="@+id/viewer_written_reference"
				style="@style/EnerGym.Body"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/group_gap"
				tools:text="Referencia escrita de la variante seleccionada · ejemplo de diseño" />

			<TextView
				android:id="@+id/viewer_credits"
				style="@style/EnerGym.FieldCaption"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/group_gap"
				android:text="@string/anatomy_credits" />
		</LinearLayout>
	</ScrollView>
</LinearLayout>
