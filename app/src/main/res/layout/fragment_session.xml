									<com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:paddingHorizontal="16dp" android:paddingVertical="16dp" android:inputType="textCapSentences" android:textColor="@color/white" android:textSize="16sp" android:saveEnabled="false" tools:text="Introduce el valor realizado" />
								</com.google.android.material.textfield.TextInputLayout>
