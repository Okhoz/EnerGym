<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true"
	android:saveEnabled="false"
	android:background="@android:color/transparent"
	android:clipToPadding="false"
	tools:context=".MainActivity">

	<LinearLayout
		android:id="@+id/screen_body"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="@dimen/screen_gutter"
		android:paddingTop="@dimen/section_gap"
		android:paddingBottom="@dimen/content_bottom">

		<TextView
			android:id="@+id/eyebrow"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/EnerGym.Eyebrow"
			tools:text="REGISTRA LO REAL" />

		<TextView
			android:id="@+id/screen_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/space_inline"
			style="@style/EnerGym.ScreenTitle"
			tools:text="Tu sesión" />

		<TextView
			android:id="@+id/screen_subtitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/space_inline"
			android:layout_marginBottom="@dimen/section_gap"
			style="@style/EnerGym.Body"
			tools:text="Escribe lo que has realizado. Los números de la propuesta son ejemplos, no resultados." />

		<LinearLayout
			android:id="@+id/rows"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="gone"
				tools:visibility="visible"
				android:importantForAccessibility="noHideDescendants">
				<!-- Solo editor: GONE en ejecución; ScreenFragment.render elimina estas filas. -->
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_marginBottom="@dimen/field_gap">

					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="@dimen/label_gap"
						style="@style/EnerGym.FieldCaption"
						tools:text="Ejercicio de la sesión" />

					<FrameLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="@drawable/choice_outline">

						<Spinner
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:minHeight="60dp"
							android:paddingEnd="40dp"
							android:spinnerMode="dropdown"
							android:background="@null"
							android:popupBackground="@drawable/choice_outline"
							android:saveEnabled="false"
							tools:visibility="gone" />

						<ImageView
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:layout_gravity="end|center_vertical"
							android:layout_marginEnd="12dp"
							android:src="@drawable/ic_expand"
							android:importantForAccessibility="no" />

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:minHeight="60dp"
							android:gravity="center_vertical"
							android:paddingHorizontal="16dp"
							android:paddingVertical="16dp"
							android:textColor="@color/white"
							android:textSize="16sp"
							tools:text="Ejercicio de ejemplo"
							android:layout_marginEnd="40dp"
							android:visibility="gone"
							tools:visibility="visible"
							android:importantForAccessibility="noHideDescendants" />
					</FrameLayout>
				</LinearLayout>

				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="@dimen/section_gap"
					style="@style/EnerGym.GlassCard">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="@dimen/card_padding"
						android:background="@drawable/glass_panel">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							style="@style/EnerGym.CardTitle"
							tools:text="Ejercicio de ejemplo" />

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/space_inline"
							style="@style/EnerGym.Body"
							tools:text="Propuesta orientativa&#xA;Ejemplo de diseño · todavía sin valores guardados." />

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_marginTop="@dimen/space_inline">

							<com.energym.app.ui.effects.GlassButton
								style="@style/EnerGym.Button"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:minHeight="@dimen/primary_touch_target"
								android:layout_marginTop="@dimen/action_gap"
								android:layout_marginBottom="0dp"
								android:textSize="16sp"
								tools:text="Ver técnica: ejercicio de ejemplo" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="@dimen/section_gap"
					style="@style/EnerGym.GlassCard">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="@dimen/card_padding"
						android:background="@drawable/glass_panel">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							style="@style/EnerGym.CardTitle"
							tools:text="Valores realizados" />

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/space_inline"
							style="@style/EnerGym.Body"
							tools:text="Fuerza · unidades explícitas&#xA;Carga cero significa peso corporal. El esfuerzo es opcional." />

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_marginTop="@dimen/space_inline">

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									style="@style/EnerGym.FieldCaption"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									tools:text="Series realizadas" />

								<com.google.android.material.textfield.TextInputLayout
									style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									app:hintEnabled="false"
									app:boxBackgroundColor="@color/glass_field"
									app:boxStrokeColor="@color/field_outline"
									app:boxStrokeWidth="1dp"
									app:boxStrokeWidthFocused="2dp"
									app:boxCornerRadiusTopStart="12dp"
									app:boxCornerRadiusTopEnd="12dp"
									app:boxCornerRadiusBottomStart="12dp"
									app:boxCornerRadiusBottomEnd="12dp">

									<com.google.android.material.textfield.TextInputEditText
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:inputType="textCapSentences"
										android:textColor="@color/white"
										android:textSize="16sp"
										android:saveEnabled="false"
										tools:text="Introduce el valor realizado" />
								</com.google.android.material.textfield.TextInputLayout>
							</LinearLayout>

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									style="@style/EnerGym.FieldCaption"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									tools:text="Repeticiones por serie" />

								<com.google.android.material.textfield.TextInputLayout
									style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									app:hintEnabled="false"
									app:boxBackgroundColor="@color/glass_field"
									app:boxStrokeColor="@color/field_outline"
									app:boxStrokeWidth="1dp"
									app:boxStrokeWidthFocused="2dp"
									app:boxCornerRadiusTopStart="12dp"
									app:boxCornerRadiusTopEnd="12dp"
									app:boxCornerRadiusBottomStart="12dp"
									app:boxCornerRadiusBottomEnd="12dp">

									<com.google.android.material.textfield.TextInputEditText
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:inputType="textCapSentences"
										android:textColor="@color/white"
										android:textSize="16sp"
										android:saveEnabled="false"
										tools:text="Introduce el valor realizado" />
								</com.google.android.material.textfield.TextInputLayout>
							</LinearLayout>

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									style="@style/EnerGym.FieldCaption"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									tools:text="Carga (kg; 0 = peso corporal)" />

								<com.google.android.material.textfield.TextInputLayout
									style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									app:hintEnabled="false"
									app:boxBackgroundColor="@color/glass_field"
									app:boxStrokeColor="@color/field_outline"
									app:boxStrokeWidth="1dp"
									app:boxStrokeWidthFocused="2dp"
									app:boxCornerRadiusTopStart="12dp"
									app:boxCornerRadiusTopEnd="12dp"
									app:boxCornerRadiusBottomStart="12dp"
									app:boxCornerRadiusBottomEnd="12dp">

									<com.google.android.material.textfield.TextInputEditText
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:inputType="textCapSentences"
										android:textColor="@color/white"
										android:textSize="16sp"
										android:saveEnabled="false"
										tools:text="Introduce el valor realizado" />
								</com.google.android.material.textfield.TextInputLayout>
							</LinearLayout>

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									style="@style/EnerGym.FieldCaption"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									tools:text="Descanso entre series (s)" />

								<com.google.android.material.textfield.TextInputLayout
									style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									app:hintEnabled="false"
									app:boxBackgroundColor="@color/glass_field"
									app:boxStrokeColor="@color/field_outline"
									app:boxStrokeWidth="1dp"
									app:boxStrokeWidthFocused="2dp"
									app:boxCornerRadiusTopStart="12dp"
									app:boxCornerRadiusTopEnd="12dp"
									app:boxCornerRadiusBottomStart="12dp"
									app:boxCornerRadiusBottomEnd="12dp">

									<com.google.android.material.textfield.TextInputEditText
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:inputType="textCapSentences"
										android:textColor="@color/white"
										android:textSize="16sp"
										android:saveEnabled="false"
										tools:text="Introduce el valor realizado" />
								</com.google.android.material.textfield.TextInputLayout>
							</LinearLayout>

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical"
								android:layout_marginBottom="@dimen/field_gap">

								<TextView
									style="@style/EnerGym.FieldCaption"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginBottom="@dimen/label_gap"
									tools:text="Esfuerzo percibido (0–10; opcional)" />

								<com.google.android.material.textfield.TextInputLayout
									style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									app:hintEnabled="false"
									app:boxBackgroundColor="@color/glass_field"
									app:boxStrokeColor="@color/field_outline"
									app:boxStrokeWidth="1dp"
									app:boxStrokeWidthFocused="2dp"
									app:boxCornerRadiusTopStart="12dp"
									app:boxCornerRadiusTopEnd="12dp"
									app:boxCornerRadiusBottomStart="12dp"
									app:boxCornerRadiusBottomEnd="12dp">

									<com.google.android.material.textfield.TextInputEditText
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:minHeight="60dp"
										android:paddingHorizontal="16dp"
										android:paddingVertical="16dp"
										android:inputType="textCapSentences"
										android:textColor="@color/white"
										android:textSize="16sp"
										android:saveEnabled="false"
										tools:text="Introduce el valor realizado" />
								</com.google.android.material.textfield.TextInputLayout>
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.energym.app.ui.effects.GlassButton
					style="@style/EnerGym.Button"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="@dimen/primary_touch_target"
					android:layout_marginTop="@dimen/action_gap"
					android:layout_marginBottom="0dp"
					android:textSize="16sp"
					tools:text="Guardar ejercicio" />

				<com.energym.app.ui.effects.GlassButton
					style="@style/EnerGym.Button"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="@dimen/primary_touch_target"
					android:layout_marginTop="@dimen/action_gap"
					android:layout_marginBottom="0dp"
					android:textSize="16sp"
					tools:text="Siguiente ejercicio" />

				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="@dimen/section_gap"
					style="@style/EnerGym.GlassCard">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="@dimen/card_padding"
						android:background="@drawable/glass_panel">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							style="@style/EnerGym.CardTitle"
							tools:text="Cerrar el entrenamiento" />

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/space_inline"
							style="@style/EnerGym.Body"
							tools:text="Ejemplo de diseño · guarda todos los ejercicios antes de finalizar." />

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_marginTop="@dimen/space_inline">

							<com.energym.app.ui.effects.GlassButton
								style="@style/EnerGym.Button"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:minHeight="@dimen/primary_touch_target"
								android:layout_marginTop="@dimen/action_gap"
								android:layout_marginBottom="0dp"
								android:textSize="16sp"
								tools:text="Finalizar sesión" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</ScrollView>
