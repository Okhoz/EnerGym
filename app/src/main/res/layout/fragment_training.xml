<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true"
	android:saveEnabled="false"
	android:background="@android:color/transparent"
	android:clipToPadding="false"
	tools:context=".MainActivity">

	<LinearLayout
		android:id="@+id/screen_body"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="@dimen/screen_gutter"
		android:paddingTop="@dimen/section_gap"
		android:paddingBottom="@dimen/content_bottom">

		<TextView
			android:id="@+id/eyebrow"
			style="@style/EnerGym.Eyebrow"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			tools:text="TU PLAN" />

		<TextView
			android:id="@+id/screen_title"
			style="@style/EnerGym.ScreenTitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/space_inline"
			tools:text="Entrenamientos" />

		<TextView
			android:id="@+id/screen_subtitle"
			style="@style/EnerGym.Body"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/space_inline"
			android:layout_marginBottom="@dimen/section_gap"
			tools:text="Tu próxima sesión, a mano." />

		<LinearLayout
			android:id="@+id/rows"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<!-- Vista previa de Mis rutinas; ScreenFragment sustituye estas filas en ejecución. -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="gone"
				android:importantForAccessibility="noHideDescendants"
				tools:visibility="visible">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="@dimen/section_gap"
					android:orientation="horizontal">

					<com.google.android.material.button.MaterialButton
						style="@style/EnerGym.Button"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1.2"
						android:minHeight="48dp"
						android:textSize="13sp"
						android:textColor="@color/surface"
						app:backgroundTint="@color/gold"
						tools:text="Mis rutinas" />

					<com.google.android.material.button.MaterialButton
						style="@style/EnerGym.Button"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:minHeight="48dp"
						android:textSize="13sp"
						tools:text="Con IA" />

					<com.google.android.material.button.MaterialButton
						style="@style/EnerGym.Button"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1.1"
						android:minHeight="48dp"
						android:textSize="13sp"
						tools:text="Ejercicios" />
				</LinearLayout>

				<com.google.android.material.card.MaterialCardView
					style="@style/EnerGym.GlassCard"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="@dimen/section_gap">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="@dimen/card_padding"
						android:background="@drawable/glass_panel">

						<TextView
							style="@style/EnerGym.FieldCaption"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							tools:text="Tu siguiente sesión" />

						<TextView
							style="@style/EnerGym.CardTitle"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/space_inline"
							tools:text="Fuerza en casa" />

						<TextView
							style="@style/EnerGym.Body"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/space_inline"
							tools:text="5 ejercicios · 30 min" />

						<com.energym.app.ui.effects.GlassButton
							style="@style/EnerGym.PrimaryButton"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/action_gap"
							android:minHeight="@dimen/primary_touch_target"
							tools:text="Empezar sesión" />

						<com.energym.app.ui.effects.GlassButton
							style="@style/EnerGym.Button"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:minHeight="48dp"
							tools:text="Ver ejercicios" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<TextView
					style="@style/EnerGym.CardTitle"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					tools:text="Mis rutinas" />

				<TextView
					style="@style/EnerGym.Body"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/space_inline"
					tools:text="Elige una rutina guardada o crea la tuya." />

				<com.energym.app.ui.effects.GlassButton
					style="@style/EnerGym.Button"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/action_gap"
					android:minHeight="48dp"
					tools:text="Crear rutina manual" />

				<com.energym.app.ui.effects.GlassButton
					style="@style/EnerGym.Button"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="48dp"
					tools:text="Más opciones" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</ScrollView>
