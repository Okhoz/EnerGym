<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:layout_marginTop="@dimen/group_gap"
	android:layout_marginBottom="@dimen/section_gap">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:baselineAligned="false">

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:paddingStart="0dp"
			android:paddingEnd="@dimen/control_gap_horizontal"
			android:orientation="vertical">

			<TextView
				android:id="@+id/home_sessions"
				style="@style/EnerGym.StatValue"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				tools:text="0" />

			<TextView
				style="@style/EnerGym.FieldCaption"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="@string/home_sessions_label" />
		</LinearLayout>

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:paddingStart="0dp"
			android:paddingEnd="@dimen/control_gap_horizontal"
			android:orientation="vertical">

			<TextView
				android:id="@+id/home_drafts"
				style="@style/EnerGym.StatValue"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				tools:text="0" />

			<TextView
				style="@style/EnerGym.FieldCaption"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="@string/home_drafts_label" />
		</LinearLayout>

	</LinearLayout>
</LinearLayout>
