<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="14dp">
    <TextView android:id="@+id/choice_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/text_secondary" android:labelFor="@id/choice_input" />
    <Spinner android:id="@+id/choice_input" android:layout_width="match_parent" android:layout_height="56dp" android:spinnerMode="dropdown" android:backgroundTint="@color/green" android:saveEnabled="false" />
</LinearLayout>
