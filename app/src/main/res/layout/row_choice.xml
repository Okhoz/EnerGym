<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:layout_marginBottom="@dimen/field_gap"
	tools:context=".MainActivity">

	<TextView
		android:id="@+id/choice_label"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="@dimen/label_gap"
		style="@style/EnerGym.FieldCaption"
		android:labelFor="@id/choice_input"
		tools:text="Actividad habitual" />

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/choice_outline">

		<Spinner
			android:id="@+id/choice_input"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="60dp"
			android:paddingEnd="40dp"
			android:spinnerMode="dropdown"
			android:background="@null"
			android:popupBackground="@drawable/choice_outline"
			android:saveEnabled="false"
			tools:visibility="gone" />

		<ImageView
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:layout_gravity="end|center_vertical"
			android:layout_marginEnd="12dp"
			android:src="@drawable/ic_expand"
			android:importantForAccessibility="no" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="60dp"
			android:gravity="center_vertical"
			android:paddingHorizontal="16dp"
			android:paddingVertical="16dp"
			android:textColor="@color/white"
			android:textSize="16sp"
			tools:text="Moderada (3–5 entrenos/semana)"
			android:layout_marginEnd="40dp"
			android:visibility="gone"
			tools:visibility="visible"
			android:importantForAccessibility="noHideDescendants" />
	</FrameLayout>

	<!-- Ayuda independiente: conserva todas las opciones reales del selector y envuelve texto grande. -->
	<TextView
		android:id="@+id/choice_helper"
		style="@style/EnerGym.FieldCaption"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/label_gap"
		android:paddingHorizontal="16dp"
		android:lineSpacingExtra="0dp"
		android:visibility="gone"
		tools:text="Elige la opción que mejor refleje una semana habitual."
		tools:visibility="visible" />
</LinearLayout>
