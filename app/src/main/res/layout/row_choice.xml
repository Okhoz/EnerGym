<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="20dp" tools:context=".MainActivity">
	<TextView android:id="@+id/choice_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" style="@style/EnerGym.FieldCaption" android:labelFor="@id/choice_input" tools:text="Selecciona una opción" />
	<FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/choice_outline">
		<Spinner android:id="@+id/choice_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:paddingEnd="40dp" android:spinnerMode="dropdown" android:background="@null" android:popupBackground="@drawable/choice_outline" android:saveEnabled="false" tools:visibility="gone" />
		<ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="12dp" android:src="@drawable/ic_expand" android:importantForAccessibility="no" />
		<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="16dp" android:textColor="@color/white" android:textSize="16sp" tools:text="Opción de ejemplo" android:layout_marginEnd="40dp" android:visibility="gone" tools:visibility="visible" android:importantForAccessibility="noHideDescendants" />
	</FrameLayout>
</LinearLayout>
