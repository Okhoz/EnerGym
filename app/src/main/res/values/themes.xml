<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Tema oscuro fijo incluso cuando el sistema está en modo claro. -->
	<style name="Base.Theme.EnerGym.SystemBars" parent="Theme.Material3.Dark.NoActionBar" />

	<style name="Base.Theme.EnerGym" parent="Base.Theme.EnerGym.SystemBars">
		<item name="colorPrimary">@color/gold</item>
		<item name="colorOnPrimary">@color/surface</item>
		<item name="colorSecondary">@color/gold</item>
		<item name="colorOnSecondary">@color/surface</item>
		<item name="colorSurface">@color/surface_card</item>
		<item name="colorSurfaceVariant">@color/surface_card</item>
		<item name="colorOnSurface">@color/text_primary</item>
		<item name="colorOnSurfaceVariant">@color/text_secondary</item>
		<item name="colorOutline">@color/outline</item>
		<item name="colorError">@color/error</item>
		<item name="android:colorBackground">@color/surface</item>
		<item name="android:windowLightStatusBar">false</item>
		<item name="android:statusBarColor">@color/surface</item>
		<item name="android:navigationBarColor">@color/surface</item>
		<item name="android:fontFamily">sans-serif</item>
		<item name="android:textColorPrimary">@color/text_primary</item>
		<item name="android:textColorSecondary">@color/text_secondary</item>
		<item name="android:colorAccent">@color/gold</item>
		<item name="materialButtonStyle">@style/EnerGym.Button</item>
		<item name="materialAlertDialogTheme">@style/EnerGym.GlassDialog</item>
	</style>

	<style name="Theme.EnerGym" parent="Base.Theme.EnerGym" />

	<style name="EnerGym.Button" parent="Widget.Material3.Button.OutlinedButton">
		<item name="backgroundTint">@color/button_surface</item>
		<item name="android:textColor">@color/button_text</item>
		<item name="strokeColor">@color/button_outline</item>
		<item name="strokeWidth">1dp</item>
		<item name="cornerRadius">20dp</item>
		<item name="rippleColor">#28D3B16B</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:paddingTop">14dp</item>
		<item name="android:paddingBottom">14dp</item>
		<item name="android:paddingLeft">16dp</item>
		<item name="android:paddingRight">16dp</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
	</style>

	<style name="EnerGym.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
		<item name="android:color">@color/surface_selected</item>
	</style>

	<style name="EnerGym.NavigationLabel" parent="TextAppearance.Material3.LabelMedium">
		<item name="android:textSize">12sp</item>
		<item name="android:textStyle">normal</item>
		<item name="android:letterSpacing">0</item>
	</style>

	<style name="EnerGym.ViewerButton" parent="EnerGym.Button">
		<item name="android:minWidth">88dp</item>
		<item name="android:minHeight">@dimen/touch_target</item>
		<item name="android:textSize">14sp</item>
		<item name="android:paddingLeft">12dp</item>
		<item name="android:paddingRight">12dp</item>
	</style>

	<style name="EnerGym.ViewerCameraButton" parent="EnerGym.ViewerButton">
		<item name="android:minWidth">120dp</item>
	</style>

	<style name="EnerGym.GlassCard" parent="Widget.Material3.CardView.Filled">
		<item name="cardBackgroundColor">@color/surface_card</item>
		<item name="cardCornerRadius">24dp</item>
		<item name="strokeColor">@color/glass_highlight</item>
		<item name="strokeWidth">1dp</item>
		<item name="cardElevation">0dp</item>
	</style>

	<style name="EnerGym.GlassDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
		<item name="colorSurface">#F01C1E1C</item>
		<item name="colorOnSurface">@color/white</item>
		<item name="colorOnSurfaceVariant">@color/text_secondary</item>
		<item name="colorPrimary">@color/gold</item>
		<item name="shapeAppearanceOverlay">@style/EnerGym.GlassDialogShape</item>
	</style>

	<style name="EnerGym.GlassDialogShape" parent="">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">24dp</item>
	</style>
	<!-- Tipografía común para todas las pantallas y futuras vistas de asistente/anatomía. -->
	<style name="EnerGym.Eyebrow" parent="">
		<item name="android:textColor">@color/text_secondary</item>
		<item name="android:textSize">13sp</item>
		<item name="android:textStyle">bold</item>
		<item name="android:letterSpacing">0.1</item>
	</style>

	<style name="EnerGym.ScreenTitle" parent="">
		<item name="android:textColor">@color/text_primary</item>
		<item name="android:textSize">30sp</item>
		<item name="android:textStyle">bold</item>
	</style>

	<style name="EnerGym.Body" parent="">
		<item name="android:textColor">@color/text_secondary</item>
		<item name="android:textSize">16sp</item>
		<item name="android:lineSpacingExtra">5dp</item>
	</style>

	<style name="EnerGym.CardTitle" parent="">
		<item name="android:textColor">@color/text_primary</item>
		<item name="android:textSize">20sp</item>
		<item name="android:textStyle">bold</item>
	</style>

	<style name="EnerGym.FieldCaption" parent="">
		<item name="android:textColor">@color/text_secondary</item>
		<item name="android:textSize">14sp</item>
		<item name="android:lineSpacingExtra">3dp</item>
	</style>
</resources>


