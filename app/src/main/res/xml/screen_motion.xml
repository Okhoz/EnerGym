<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
	<!-- Solo navegación explícita: no hay OnSwipe ni autoTransition sobre formularios. -->
	<Transition app:constraintSetStart="@id/screen_enter" app:constraintSetEnd="@id/screen_rest" app:duration="260" app:motionInterpolator="decelerate" app:layoutDuringTransition="honorRequest" />
	<ConstraintSet android:id="@+id/screen_rest">
		<Constraint android:id="@id/content" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
			<PropertySet android:alpha="1" />
			<Transform android:translationY="0dp" />
		</Constraint>
	</ConstraintSet>
	<ConstraintSet android:id="@+id/screen_enter" app:deriveConstraintsFrom="@id/screen_rest">
		<Constraint android:id="@id/content">
			<PropertySet android:alpha="0.82" />
			<Transform android:translationY="12dp" />
		</Constraint>
	</ConstraintSet>
</MotionScene>
